# TrizenDialog API base URL (no trailing slash)
# Development: local trizendialog-backend
VITE_API_URL=http://localhost:4010/api/v1

# Dev-only: browse all screens as admin without logging in (npm run dev only; ignored in production builds)
VITE_DEV_MOCK_AUTH=true

# Production example:
# VITE_API_URL=https://api.trizendialog.example.com/api/v1
#
# Deployment notes:
# - Backend must allow this origin in CORS (configure trizendialog-backend CORS_ORIGINS)
# - Build with: VITE_API_URL=<prod-url> npm run build
# - Serve dist/ via static host (nginx, S3+CloudFront, etc.)
