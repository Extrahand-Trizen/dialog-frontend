# Local development — read by Vite at dev/build time.
# In Docker/CapRover, set VITE_API_URL (or API_URL) as container env vars instead (runtime).

VITE_API_URL=http://localhost:4010/api/v1

# Dev-only: browse all screens as admin without logging in (npm run dev only)
VITE_DEV_MOCK_AUTH=true

# Production Docker/CapRover (runtime — change without rebuild):
# VITE_API_URL=https://wa-dialog-backend.backend.extrahand.in/api/v1
#
# Backend CapRover env (origin only — no /login path):
# CORS_ORIGIN=https://wa-dialog-frontend.backend.extrahand.in
