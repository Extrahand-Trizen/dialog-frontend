# Local development — Vite loads this file; it is gitignored (.env is never committed).
# GitHub Actions does NOT use this file — set Variable NEXT_PUBLIC_API_URL in the repo instead.

# Preferred name (matches CI / shared frontend convention):
NEXT_PUBLIC_API_URL=http://localhost:4010/api/v1

# Legacy alias still supported by Vite:
# VITE_API_URL=http://localhost:4010/api/v1

# Dev-only: browse all screens as admin without logging in (npm run dev only)
VITE_DEV_MOCK_AUTH=true

# Production example (no trailing slash; must include /api/v1):
# NEXT_PUBLIC_API_URL=https://wa-dialog-backend.backend.extrahand.in/api/v1
#
# Backend CORS must allow your frontend origin, e.g.:
# CORS_ORIGIN=https://trizendialog.extrahand.in,https://frontend-builds-api.apps.extrahand.in
